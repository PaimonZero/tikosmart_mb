{
  "expo": {
    "name": "tikosmart_mb",
    "slug": "tikosmart_mb",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/tikoSmart.png",
    "scheme": "tikosmartmb",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/tikoSmart.png",
        "backgroundImage": "./assets/images/tikoSmart.png",
        "monochromeImage": "./assets/images/tikoSmart.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.vietcong221.tikosmart_mb"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/tikoSmart.png"
    },
    "plugins": [
      "expo-router",
      "./plugins/withAndroidSingleTask",
      [
        "expo-image-picker",
        {
          "photosPermission": "Cho phép Tikosmart truy cập thư viện ảnh để tải ảnh lên.",
          "cameraPermission": "Cho phép Tikosmart truy cập camera để chụp ảnh."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/tikoSmart.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "833a6f4b-d6e1-4eba-8959-c5e180f2b748"
      }
    }
  }
}
